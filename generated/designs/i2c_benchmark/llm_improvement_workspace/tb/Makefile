# Makefile for the i2c_master cocotb + pyuvm testbench (Verilator flow)
#
# Generated by the CHIA integration stage.  Usage:
#   make                                   # run default test: I2C01ResetBehaviorTest
#   make UVM_TESTNAME=I2C14BackToBackTest  # run a specific test
#   make regression                         # run every test class (16 runs)
#   make UVM_TESTNAME=I2CRandomizedTest I2C_SEED=42   # replayable random run
#
# All parameters are exported as environment variables and read by
# tb/test_top.py (and tb/test.py for the randomized test's seed).

# ---- cocotb simulation settings ------------------------------------------
SIM             = verilator
TOPLEVEL        = i2c_master
MODULE          = test_top

# ---- paths (repo root so `benchmarks.*` imports work; tb dir for `tb.*`) --
REPO_ROOT      ?= $(abspath $(CURDIR)/../../../..)
TB_DIR         ?= $(CURDIR)

# ---- RTL source (read-only; never modified by the bench) ------------------
VERILOG_SOURCES = $(REPO_ROOT)/benchmarks/i2c_benchmark/i2c_master.sv

# ---- Python path: repo root + this tb directory ---------------------------
export PYTHONPATH := $(REPO_ROOT):$(TB_DIR):$(PYTHONPATH)

# ---- Verilator compile / sim flags ---------------------------------------
# --timing:  needed for the async (negedge rst_n) reset FSM.
# -Wno-*:    silence common benign-width/synthesis warnings.
# -j 0:      parallel build (verilator_compatibility: build_parallelism).
COMPILE_ARGS    += --timing -DUVM_NO_DPI
COMPILE_ARGS    += -Wno-WIDTH -Wno-CASEINCOMPLETE -Wno-UNOPTFLAT
COMPILE_ARGS    += -j 0

# ---- cocotb test parameters (overridable on the make command line) -------
UVM_TESTNAME            ?= I2C01ResetBehaviorTest
I2C_CLK_PERIOD_NS       ?= 10
I2C_WATCHDOG_CYCLES     ?= 300000
I2C_SEED                ?=           # randomized-test replay seed (optional)

export UVM_TESTNAME
export I2C_CLK_PERIOD_NS
export I2C_WATCHDOG_CYCLES
export I2C_SEED

# ---- Wave dumping (optional; uncomment for FST traces) -------------------
# COMPILE_ARGS += --trace
# EXTRA_ARGS   += --trace-fst

# ---- Regression: every test class from generation_manifest.yaml ----------
TESTS := I2C01ResetBehaviorTest I2C02WriteThenReadBackTest \
         I2C03ReadBeforeWriteTest I2C04RepeatedWritesTest \
         I2C05BoundaryAddr00Test I2C06BoundaryAddrFFTest \
         I2C07UnsupportedSlave00Test I2C08UnsupportedSlave01Test \
         I2C09UnsupportedSlave7FTest I2C10StartWhileBusyTest \
         I2C11DonePulseWidthTest I2C12OpenDrainBusReleaseTest \
         I2C13MultiRegIndependenceTest I2C14BackToBackTest \
         I2CCornerCaseTest I2CRandomizedTest

.PHONY: regression
regression:
	@echo "== i2c_master regression: $(words $(TESTS)) tests =="
	@for t in $(TESTS); do \
		echo "== running $$t =="; \
		$(MAKE) UVM_TESTNAME=$$t SIM_BUILD=sim_build_$$t \
		        COCOTB_RESULTS_FILE=results_$$t.xml || exit 1; \
	done
	@echo "== i2c_master regression: PASS =="

.PHONY: clean
clean:
	rm -rf sim_build sim_build_* results*.xml *.fst *.vcd

# ---- cocotb flow (must be included last) ----------------------------------
include $(shell cocotb-config --makefiles)/Makefile.sim