# Layer the LLM-driven UVM testbench generator on top of Berkeley's
# chia-verilator-run image, which already ships Verilator + the Chipyard
# toolchain inside the `chia_env` conda environment.
FROM ghcr.io/ucb-bar/chia-verilator-run:latest

SHELL ["/bin/bash", "-lc"]

ENV PROJECT_DIR=/opt/llm-uvm-tb-generator
WORKDIR ${PROJECT_DIR}

# Build context should be the repo root (llm-uvm-tb-generator/)
COPY . ${PROJECT_DIR}

# Install this project's python deps into the SAME conda env the cluster
# activates in head_env_commands / head_setup_commands, so `ray` tasks
# scheduled onto this container see both verilator/chipyard AND our deps.
RUN source ~/.bashrc && conda activate chia_env && \
    pip install --no-cache-dir -r requirements.txt

RUN chmod +x scripts/*.sh scripts/*.py chipyard_integration/*.sh 2>/dev/null || true

# ANTHROPIC_API_KEY is expected to be injected at container run time
# (via `--env-file=.env` in cluster.yaml's run_options, or `docker run -e`).
ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["source ~/.bashrc && conda activate chia_env && exec bash"]
