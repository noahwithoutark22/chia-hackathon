{
  "schema_version": "1.0",
  "dut_name": "adder",
  "clock_signal": "clk",
  "reset_signal": "rst_n",
  "reset_active_low": true,
  "transaction_inputs": [
    { "signal": "a", "width": 8 },
    { "signal": "b", "width": 8 },
    { "signal": "cin", "width": 1 }
  ],
  "transaction_outputs": [
    { "signal": "sum", "width": 8 },
    { "signal": "cout", "width": 1 }
  ],
  "driver": {
    "sample_event": "posedge",
    "drive_before_edge": true,
    "inputs": [
      { "signal": "a", "width": 8 },
      { "signal": "b", "width": 8 },
      { "signal": "cin", "width": 1 }
    ]
  },
  "monitor": {
    "sample_event": "posedge",
    "outputs": [
      { "signal": "sum", "width": 8 },
      { "signal": "cout", "width": 1 }
    ],
    "inputs": [
      { "signal": "a", "width": 8 },
      { "signal": "b", "width": 8 },
      { "signal": "cin", "width": 1 }
    ]
  },
  "scoreboard": {
    "latency_cycles": 1,
    "input_signals": ["a", "b", "cin"],
    "output_signals": ["sum", "cout"],
    "reference_model": {
      "path": "examples/adder/ref_model.py",
      "function": "adder_ref",
      "arguments": [
        { "name": "a", "source": "transaction", "signal": "a" },
        { "name": "b", "source": "transaction", "signal": "b" },
        { "name": "cin", "source": "transaction", "signal": "cin" },
        { "name": "width", "source": "constant", "value": 8 }
      ],
      "outputs": [
        { "signal": "sum", "width": 8 },
        { "signal": "cout", "width": 1 }
      ],
      "integration": "embedded_python_dpi_c"
    }
  },
  "scenarios": [
    {
      "name": "reset_clears_outputs",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 255, "cin": 1 }
    },
    {
      "name": "basic_add_no_carry",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 1, "b": 2, "cin": 0 }
    },
    {
      "name": "carry_propagation_all_positions",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 128, "b": 127, "cin": 1 }
    },
    {
      "name": "overflow_max_operands",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 255, "cin": 1 }
    },
    {
      "name": "cin_in_isolation",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 0, "b": 0, "cin": 1 }
    },
    {
      "name": "alternating_bit_pattern",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 170, "b": 85, "cin": 1 }
    },
    {
      "name": "back_to_back_additions",
      "directed": true,
      "repeat": 1,
      "constraints": [
        "two additions driven on consecutive cycles: (a=3, b=4, cin=0) then (a=10, b=10, cin=0); expect sum 7 then sum 20, cout 0 both"
      ],
      "values": { "a": 10, "b": 10, "cin": 0 }
    },
    {
      "name": "reset_release_resumes_addition",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 100, "b": 50, "cin": 0 }
    },
    {
      "name": "all_zero_inputs",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 0, "b": 0, "cin": 0 }
    },
    {
      "name": "max_operands_no_cin",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 255, "cin": 0 }
    },
    {
      "name": "a_max_cin_increment",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 0, "cin": 1 }
    },
    {
      "name": "b_max_cin_increment",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 0, "b": 255, "cin": 1 }
    },
    {
      "name": "reset_with_pending_carry",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 255, "cin": 1 }
    },
    {
      "name": "random_full_space",
      "directed": false,
      "repeat": 2000,
      "constraints": [
        "a inside [0, 255]",
        "b inside [0, 255]",
        "cin inside {0, 1}",
        "mid-test reset: assert rst_n for 3 cycles once per test (asynchronous active-low), release, and resume scoreboard comparisons"
      ],
      "values": {}
    }
  ],
  "assertions": [
    {
      "name": "reset_clears_outputs",
      "property": "posedge clk: !rst_n |-> (sum == 0 && cout == 0)",
      "severity": "error"
    },
    {
      "name": "registered_addition_correct",
      "property": "posedge clk: rst_n |=> ({cout, sum} == $past(a) + $past(b) + $past(cin))",
      "severity": "error"
    },
    {
      "name": "carry_out_is_overflow",
      "property": "posedge clk: rst_n |=> (cout == (($past(a) + $past(b) + $past(cin)) >> WIDTH))",
      "severity": "error"
    },
    {
      "name": "sum_low_width_bits",
      "property": "posedge clk: rst_n |=> (sum == (($past(a) + $past(b) + $past(cin)) % 2**WIDTH))",
      "severity": "error"
    }
  ],
  "coverage": [
    {
      "name": "cp_a",
      "signal": "a",
      "bins": [
        { "a_zero": "a == 0" },
        { "a_max": "a == 2**WIDTH - 1" },
        { "a_msb_set": "a[WIDTH-1] == 1" },
        { "a_lsb_set": "a[0] == 1" }
      ]
    },
    {
      "name": "cp_b",
      "signal": "b",
      "bins": [
        { "b_zero": "b == 0" },
        { "b_max": "b == 2**WIDTH - 1" },
        { "b_msb_set": "b[WIDTH-1] == 1" },
        { "b_lsb_set": "b[0] == 1" }
      ]
    },
    {
      "name": "cp_cin",
      "signal": "cin",
      "bins": [
        { "cin_0": "{0}" },
        { "cin_1": "{1}" }
      ]
    },
    {
      "name": "cp_sum",
      "signal": "sum",
      "bins": [
        { "sum_zero": "sum == 0" },
        { "sum_max": "sum == 2**WIDTH - 1" },
        { "sum_msb_set": "sum[WIDTH-1] == 1" }
      ]
    },
    {
      "name": "cp_cout",
      "signal": "cout",
      "bins": [
        { "cout_0": "{0}" },
        { "cout_1": "{1}" }
      ]
    }
  ]
}