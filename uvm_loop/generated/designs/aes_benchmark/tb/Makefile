# Makefile for the aes128 cocotb + pyuvm testbench (Verilator flow)
#
# Generated by the CHIA integration stage.  Usage:
#   make                                   # run default test: AESNistKatTest
#   make UVM_TESTNAME=AESResetMidTransactionTest   # run a specific test
#   make regression                         # run every test class (13 runs)
#   make UVM_TESTNAME=AESRandomizedTest AES_SEED=42   # replayable random run
#
# All parameters are exported as environment variables and read by
# tb/test_top.py (and tb/test.py for the randomized test's knobs).
#
# NOTE ON EXPECTED RESULTS: the target RTL is intentionally buggy per the
# verification plan (DISC-001: the final-round MixColumns guard never fires,
# so MixColumns runs in all ten rounds).  The scoreboard compares DUT output
# against the FIPS-197-correct reference model, so every test that completes
# at least one transaction FAILS on mismatch - that failure is the intended
# bug-detection outcome.  Only AESResetMidTransactionTest (which by design
# completes no transaction) is expected to pass.

# ---- cocotb simulation settings ------------------------------------------
SIM             = verilator
TOPLEVEL        = aes128
MODULE          = test_top

# ---- paths (repo root so `benchmarks.*` imports work; tb dir for `tb.*`) --
REPO_ROOT      ?= $(abspath $(CURDIR)/../../../..)
DESIGN_DIR     ?= $(abspath $(CURDIR)/..)
TB_DIR         ?= $(CURDIR)

# ---- RTL source (read-only; never modified by the bench) ------------------
VERILOG_SOURCES = $(REPO_ROOT)/benchmarks/aes_benchmark/aes128.sv

# ---- Python path: repo root + design dir (namespace pkg `tb.*`) + tb dir --
export PYTHONPATH := $(REPO_ROOT):$(DESIGN_DIR):$(TB_DIR):$(PYTHONPATH)

# ---- Verilator compile / sim flags ---------------------------------------
# --timing:  needed for the async (negedge rst_n) reset FSM.
# -Wno-*:    silence common benign-width/synthesis warnings.
# -j 0:      parallel build (verilator_compatibility: build_parallelism).
COMPILE_ARGS    += --timing -DUVM_NO_DPI
COMPILE_ARGS    += -Wno-WIDTH -Wno-CASEINCOMPLETE -Wno-UNOPTFLAT
COMPILE_ARGS    += -j 0

# ---- cocotb test parameters (overridable on the make command line) -------
UVM_TESTNAME            ?= AESNistKatTest
AES_CLK_PERIOD_NS       ?= 10
AES_WATCHDOG_CYCLES     ?= 500000
AES_NUM_RANDOM          ?= 1000
AES_IN_FLIGHT_RESET_PROB ?= 0.05
AES_IDLE_RESET_PROB     ?= 0.10
AES_SEED                ?=           # randomized-test replay seed (optional)

export UVM_TESTNAME
export AES_CLK_PERIOD_NS
export AES_WATCHDOG_CYCLES
export AES_NUM_RANDOM
export AES_IN_FLIGHT_RESET_PROB
export AES_IDLE_RESET_PROB
export AES_SEED

# ---- Wave dumping (optional; uncomment for FST traces) -------------------
# COMPILE_ARGS += --trace
# EXTRA_ARGS   += --trace-fst

# ---- Regression: every test class from generation_manifest.yaml ----------
# Note: by design (DISC-001) only AESResetMidTransactionTest passes; all
# directed/corner/randomized data-path tests fail on the oracle mismatch.
TESTS := AESNistKatTest AESAllZerosTest AESAllOnesTest \
         AESAlternatingTest AESZeroKeyNonzeroPtTest \
         AESNonzeroKeyZeroPtTest AESInputChangeWhileBusyTest \
         AESRepeatedTransactionsTest AESDonePulseWidthTest \
         AESResetDuringIdleTest AESResetMidTransactionTest \
         AESCornerCaseTest AESRandomizedTest

.PHONY: regression
regression:
	@echo "== aes128 regression: $(words $(TESTS)) tests =="
	@for t in $(TESTS); do \
		echo "== running $$t =="; \
		$(MAKE) UVM_TESTNAME=$$t SIM_BUILD=sim_build_$$t \
		        COCOTB_RESULTS_FILE=results_$$t.xml || exit 1; \
	done
	@echo "== aes128 regression: PASS =="

.PHONY: clean
clean:
	rm -rf sim_build sim_build_* results*.xml *.fst *.vcd

# ---- cocotb flow (must be included last) ----------------------------------
include $(shell cocotb-config --makefiles)/Makefile.sim