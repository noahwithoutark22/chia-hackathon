# Run outputs — regenerated by the loops, never source of truth.
# orfs_loop/ has its own .gitignore covering orfs_runs/ (which deliberately
# keeps the bp-sky-gcd sample); do not duplicate those rules here.
eval_results/
uvm_loop/generated/*
!uvm_loop/generated/designs/
uvm_loop/generated/designs/*
!uvm_loop/generated/designs/README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Local credentials — committed examples live in templates/
opencode.jsonc
opencode_auth.json
.env

# Editor / OS
.DS_Store
*.swp
*~

# Build/tool cache
.cache/
