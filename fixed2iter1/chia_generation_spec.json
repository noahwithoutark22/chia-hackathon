{
  "schema_version": "1.0",
  "dut_name": "adder",
  "clock_signal": "clk",
  "reset_signal": "rst_n",
  "reset_active_low": true,
  "transaction_inputs": [
    { "signal": "a", "width": 8 },
    { "signal": "b", "width": 8 },
    { "signal": "cin", "width": 1 }
  ],
  "transaction_outputs": [
    { "signal": "sum", "width": 8 },
    { "signal": "cout", "width": 1 }
  ],
  "driver": {
    "sample_event": "posedge",
    "drive_before_edge": true,
    "inputs": [
      { "signal": "a", "width": 8 },
      { "signal": "b", "width": 8 },
      { "signal": "cin", "width": 1 }
    ]
  },
  "monitor": {
    "sample_event": "posedge",
    "outputs": [
      { "signal": "sum", "width": 8 },
      { "signal": "cout", "width": 1 }
    ],
    "inputs": [
      { "signal": "a", "width": 8 },
      { "signal": "b", "width": 8 },
      { "signal": "cin", "width": 1 }
    ]
  },
  "scoreboard": {
    "latency_cycles": 1,
    "input_signals": ["a", "b", "cin"],
    "output_signals": ["sum", "cout"],
    "reference_model": {
      "path": "examples/adder/ref_model.py",
      "function": "adder_ref",
      "arguments": [
        { "name": "a", "source": "transaction", "signal": "a" },
        { "name": "b", "source": "transaction", "signal": "b" },
        { "name": "cin", "source": "transaction", "signal": "cin" },
        { "name": "width", "source": "constant", "value": 8 }
      ],
      "outputs": [
        { "signal": "sum", "width": 8 },
        { "signal": "cout", "width": 1 }
      ],
      "integration": "embedded_python_dpi_c"
    }
  },
  "scenarios": [
    {
      "name": "reset_asserted_clears_outputs",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 173, "b": 91, "cin": 1 }
    },
    {
      "name": "reset_recovery_first_cycle",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 5, "b": 3, "cin": 0 }
    },
    {
      "name": "zero_plus_zero",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 0, "b": 0, "cin": 0 }
    },
    {
      "name": "cin_only",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 0, "b": 0, "cin": 1 }
    },
    {
      "name": "simple_addition",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 5, "b": 3, "cin": 0 }
    },
    {
      "name": "maximum_without_overflow",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 127, "b": 128, "cin": 0 }
    },
    {
      "name": "first_overflow",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 128, "b": 128, "cin": 0 }
    },
    {
      "name": "overflow_via_cin",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 0, "cin": 1 }
    },
    {
      "name": "full_carry_ripple",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 255, "cin": 1 }
    },
    {
      "name": "max_operands_without_cin",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 255, "cin": 0 }
    },
    {
      "name": "alternating_bit_patterns",
      "directed": true,
      "repeat": 2,
      "constraints": [],
      "values": { "a": 85, "b": 170, "cin": 0 }
    },
    {
      "name": "power_of_two_boundary",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 128, "b": 127, "cin": 0 }
    },
    {
      "name": "back_to_back_additions",
      "directed": true,
      "repeat": 3,
      "constraints": [],
      "values": { "a": 5, "b": 3, "cin": 0 }
    },
    {
      "name": "output_hold_stability",
      "directed": true,
      "repeat": 4,
      "constraints": [],
      "values": { "a": 15, "b": 7, "cin": 1 }
    },
    {
      "name": "reset_during_operation",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 200, "b": 100, "cin": 1 }
    },
    {
      "name": "random_full_space",
      "directed": false,
      "repeat": 131072,
      "constraints": [
        "a inside [0, 255]",
        "b inside [0, 255]",
        "cin inside {0, 1}"
      ],
      "values": {}
    }
  ],
  "assertions": [
    {
      "name": "asrt_reset_clears_outputs",
      "property": "!rst_n |-> (sum == 0 && cout == 0) at posedge clk",
      "severity": "error"
    },
    {
      "name": "asrt_inputs_valid",
      "property": "disable iff (!rst_n) (!$isunknown(a) && !$isunknown(b) && !$isunknown(cin)) at posedge clk",
      "severity": "error"
    },
    {
      "name": "asrt_outputs_valid",
      "property": "disable iff (!rst_n) (!$isunknown(sum) && !$isunknown(cout)) at posedge clk",
      "severity": "error"
    }
  ],
  "coverage": [
    {
      "name": "cp_a",
      "signal": "a",
      "bins": [
        { "B_ZERO": "{0}" },
        { "B_ONE": "{1}" },
        { "B_MAX": "{255}" },
        { "B_HALF": "{128}" },
        { "B_HALF_MINUS_ONE": "{127}" }
      ]
    },
    {
      "name": "cp_b",
      "signal": "b",
      "bins": [
        { "B_ZERO": "{0}" },
        { "B_ONE": "{1}" },
        { "B_MAX": "{255}" },
        { "B_HALF": "{128}" },
        { "B_HALF_MINUS_ONE": "{127}" }
      ]
    },
    {
      "name": "cp_cin",
      "signal": "cin",
      "bins": [
        { "B_ZERO": "{0}" },
        { "B_ONE": "{1}" }
      ]
    },
    {
      "name": "cp_sum",
      "signal": "sum",
      "bins": [
        { "B_ZERO": "{0}" },
        { "B_ONE": "{1}" },
        { "B_MAX": "{255}" }
      ]
    },
    {
      "name": "cp_cout",
      "signal": "cout",
      "bins": [
        { "B_ZERO": "{0}" },
        { "B_ONE": "{1}" }
      ]
    }
  ]
}
