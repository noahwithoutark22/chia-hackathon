{
  "schema_version": "1.1",
  "dut_name": "adder",
  "clock_signal": "clk",
  "reset_signal": "rst_n",
  "reset_active_low": true,
  "reset_type": "asynchronous_assert_synchronous_deassert",
  "transaction_inputs": [
    {"signal": "a", "width": 8},
    {"signal": "b", "width": 8},
    {"signal": "cin", "width": 1}
  ],
  "transaction_outputs": [
    {"signal": "sum", "width": 8},
    {"signal": "cout", "width": 1}
  ],
  "driver": {
    "sample_event": "posedge",
    "drive_before_edge": true,
    "inputs": [
      {"signal": "a", "width": 8},
      {"signal": "b", "width": 8},
      {"signal": "cin", "width": 1}
    ]
  },
  "monitor": {
    "sample_event": "posedge",
    "outputs": [
      {"signal": "sum", "width": 8},
      {"signal": "cout", "width": 1}
    ],
    "inputs": [
      {"signal": "a", "width": 8},
      {"signal": "b", "width": 8},
      {"signal": "cin", "width": 1}
    ]
  },
  "scoreboard": {
    "latency_cycles": 1,
    "input_signals": ["a", "b", "cin"],
    "output_signals": ["sum", "cout"],
    "reference_model": {
      "path": "examples/adder/ref_model.py",
      "function": "adder_ref",
      "arguments": [
        {"name": "a", "source": "transaction", "signal": "a"},
        {"name": "b", "source": "transaction", "signal": "b"},
        {"name": "cin", "source": "transaction", "signal": "cin"},
        {"name": "width", "source": "constant", "value": 8}
      ],
      "outputs": [
        {"signal": "sum", "width": 8},
        {"signal": "cout", "width": 1}
      ],
      "integration": "embedded_python_dpi_c"
    }
  },
  "scenarios": [
    {
      "name": "reset_check",
      "directed": true,
      "repeat": 1,
      "values": {"a": 0, "b": 0, "cin": 0}
    },
    {
      "name": "basic_addition_no_carry",
      "directed": true,
      "repeat": 1,
      "values": {"a": 3, "b": 4, "cin": 0}
    },
    {
      "name": "cin_isolation",
      "directed": true,
      "repeat": 1,
      "values": {"a": 0, "b": 0, "cin": 1}
    },
    {
      "name": "overflow_max_plus_one",
      "directed": true,
      "repeat": 1,
      "values": {"a": 255, "b": 1, "cin": 0}
    },
    {
      "name": "all_ones_plus_cin",
      "directed": true,
      "repeat": 1,
      "values": {"a": 255, "b": 255, "cin": 1}
    },
    {
      "name": "registered_output_latency",
      "directed": true,
      "repeat": 1,
      "values": {"a": 5, "b": 6, "cin": 0}
    },
    {
      "name": "reset_during_operation",
      "directed": true,
      "repeat": 1,
      "values": {"a": 255, "b": 255, "cin": 1}
    },
    {
      "name": "corner_max_operands_plus_cin",
      "directed": true,
      "repeat": 1,
      "values": {"a": 255, "b": 255, "cin": 1}
    },
    {
      "name": "corner_max_plus_one_overflow",
      "directed": true,
      "repeat": 1,
      "values": {"a": 255, "b": 1, "cin": 0}
    },
    {
      "name": "corner_zero_plus_zero_plus_cin",
      "directed": true,
      "repeat": 1,
      "values": {"a": 0, "b": 0, "cin": 1}
    },
    {
      "name": "corner_max_plus_max_no_cin",
      "directed": true,
      "repeat": 1,
      "values": {"a": 255, "b": 255, "cin": 0}
    },
    {
      "name": "corner_alternating_patterns",
      "directed": true,
      "repeat": 1,
      "values": {"a": 170, "b": 85, "cin": 1}
    },
    {
      "name": "randomized_full_space",
      "directed": false,
      "repeat": 10000,
      "constraints": [
        "a in [0,255]",
        "b in [0,255]",
        "cin in [0,1]"
      ]
    }
  ],
  "assertions": [
    {
      "name": "assert_reset_clears_outputs",
      "property": "(rst_n == 0) |-> (sum == 0 && cout == 0)",
      "severity": "error"
    },
    {
      "name": "assert_registered_sum_cout_correct",
      "property": "(posedge clk, gated by reset-recovery guard) {cout, sum} equals a + b + cin of the inputs one cycle earlier",
      "severity": "error"
    },
    {
      "name": "assert_no_x_on_outputs",
      "property": "after reset deassertion, sum and cout are never X or Z",
      "severity": "error"
    },
    {
      "name": "assert_overflow_when_all_ones_plus_cin",
      "property": "(posedge clk, gated by reset-recovery guard) if prior a and b were all-ones and cin high, cout must be 1",
      "severity": "error"
    },
    {
      "name": "assert_reset_recovery_cleared",
      "property": "on rst_n deassertion edge (rose of active-low rst_n), sum == 0 && cout == 0",
      "severity": "error"
    }
  ],
  "coverage": [
    {
      "name": "opA_cov",
      "signal": "a",
      "bins": [
        {"name": "zero", "range": "0-0"},
        {"name": "one", "range": "1-1"},
        {"name": "low", "range": "2-63"},
        {"name": "mid", "range": "64-191"},
        {"name": "high", "range": "192-254"},
        {"name": "max", "range": "255-255"}
      ]
    },
    {
      "name": "opB_cov",
      "signal": "b",
      "bins": [
        {"name": "zero", "range": "0-0"},
        {"name": "one", "range": "1-1"},
        {"name": "low", "range": "2-63"},
        {"name": "mid", "range": "64-191"},
        {"name": "high", "range": "192-254"},
        {"name": "max", "range": "255-255"}
      ]
    },
    {
      "name": "cin_cov",
      "signal": "cin",
      "bins": [
        {"name": "c_zero", "range": "0-0"},
        {"name": "c_one", "range": "1-1"}
      ]
    },
    {
      "name": "sum_cov",
      "signal": "sum",
      "bins": [
        {"name": "s_zero", "range": "0-0"},
        {"name": "s_mid", "range": "1-254"},
        {"name": "s_max", "range": "255-255"}
      ]
    },
    {
      "name": "overflow_cov",
      "signal": "cout",
      "bins": [
        {"name": "no_carry", "range": "0-0"},
        {"name": "carry", "range": "1-1"}
      ]
    },
    {
      "name": "reset_seen",
      "signal": "rst_n",
      "bins": [
        {"name": "asserted", "range": "0-0"}
      ]
    },
    {
      "name": "reset_sum",
      "signal": "sum",
      "bins": [
        {"name": "cleared", "range": "0-0"}
      ]
    },
    {
      "name": "reset_cout",
      "signal": "cout",
      "bins": [
        {"name": "cleared", "range": "0-0"}
      ]
    }
  ],
  "coverage_crosses": [
    {
      "name": "cin_x_cout",
      "coverpoints": ["cin_cov", "overflow_cov"]
    },
    {
      "name": "operand_edges_x_cout",
      "coverpoints": ["opA_cov", "opB_cov", "overflow_cov"]
    }
  ]
}
