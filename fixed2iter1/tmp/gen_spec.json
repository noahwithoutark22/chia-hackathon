{
  "schema_version": "1.1",
  "dut_name": "adder",
  "clock_signal": "clk",
  "reset_signal": "rst_n",
  "reset_active_low": true,
  "reset_type": "asynchronous",
  "transaction_inputs": [
    { "signal": "a", "width": 8 },
    { "signal": "b", "width": 8 },
    { "signal": "cin", "width": 1 }
  ],
  "transaction_outputs": [
    { "signal": "sum", "width": 8 },
    { "signal": "cout", "width": 1 }
  ],
  "driver": {
    "sample_event": "posedge",
    "drive_before_edge": true,
    "inputs": [
      { "signal": "a", "width": 8 },
      { "signal": "b", "width": 8 },
      { "signal": "cin", "width": 1 }
    ]
  },
  "monitor": {
    "sample_event": "posedge",
    "outputs": [
      { "signal": "sum", "width": 8 },
      { "signal": "cout", "width": 1 }
    ],
    "inputs": [
      { "signal": "a", "width": 8 },
      { "signal": "b", "width": 8 },
      { "signal": "cin", "width": 1 }
    ]
  },
  "scoreboard": {
    "latency_cycles": 1,
    "input_signals": ["a", "b", "cin"],
    "output_signals": ["sum", "cout"],
    "reference_model": {
      "path": "examples/adder/ref_model.py",
      "function": "adder_ref",
      "arguments": [
        { "name": "a", "source": "transaction", "signal": "a" },
        { "name": "b", "source": "transaction", "signal": "b" },
        { "name": "cin", "source": "transaction", "signal": "cin" },
        { "name": "width", "source": "constant", "value": 8 }
      ],
      "outputs": [
        { "signal": "sum", "width": 8 },
        { "signal": "cout", "width": 1 }
      ],
      "integration": "embedded_python_dpi_c"
    }
  },
  "scenarios": [
    {
      "name": "basic_addition_no_carry",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 3, "b": 4, "cin": 0 }
    },
    {
      "name": "cin_in_isolation",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 0, "b": 0, "cin": 1 }
    },
    {
      "name": "carry_propagation_across_bits",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 127, "b": 1, "cin": 0 }
    },
    {
      "name": "overflow_set",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 255, "cin": 0 }
    },
    {
      "name": "max_plus_cin_overflow",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 0, "cin": 1 }
    },
    {
      "name": "zero_zero_zero",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 0, "b": 0, "cin": 0 }
    },
    {
      "name": "all_ones_plus_one",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 1, "cin": 0 }
    },
    {
      "name": "both_max_plus_cin",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 255, "cin": 1 }
    },
    {
      "name": "alternating_bits_carry_chain",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 170, "b": 85, "cin": 1 }
    },
    {
      "name": "reset_during_operation",
      "directed": true,
      "repeat": 1,
      "constraints": [],
      "values": { "a": 255, "b": 255, "cin": 1 }
    },
    {
      "name": "random_full_space",
      "directed": false,
      "repeat": 2000,
      "constraints": [
        "a inside [0, 255]",
        "b inside [0, 255]",
        "cin inside {0, 1}"
      ],
      "values": {}
    }
  ],
  "assertions": [
    {
      "name": "asrt_reset_clears_outputs",
      "property": "when rst_n is asserted low, sum and cout are cleared to 0",
      "severity": "error"
    },
    {
      "name": "asrt_sum_matches_a_plus_b_plus_cin",
      "property": "after one rising edge with reset deasserted, sum equals (a+b+cin) mod 2**WIDTH and cout equals (a+b+cin) >> WIDTH",
      "severity": "error"
    },
    {
      "name": "asrt_cout_requires_overflow",
      "property": "cout is set only when the (WIDTH+1)-bit sum exceeds the WIDTH-bit range",
      "severity": "error"
    },
    {
      "name": "asrt_width_bound",
      "property": "sum stays within WIDTH bits and cout is a single bit (0 or 1)",
      "severity": "warning"
    },
    {
      "name": "asrt_outputs_stable_between_edges",
      "property": "registered sum and cout hold stable while inputs are stable between clock edges",
      "severity": "warning"
    }
  ],
  "coverage": [
    {
      "name": "cp_a",
      "signal": "a",
      "bins": [
        { "a_zero": "{0}" },
        { "a_mid": "{[1: 254]}" },
        { "a_max": "{255}" }
      ]
    },
    {
      "name": "cp_b",
      "signal": "b",
      "bins": [
        { "b_zero": "{0}" },
        { "b_mid": "{[1: 254]}" },
        { "b_max": "{255}" }
      ]
    },
    {
      "name": "cp_cin",
      "signal": "cin",
      "bins": [
        { "cin_0": "{0}" },
        { "cin_1": "{1}" }
      ]
    },
    {
      "name": "cp_cout",
      "signal": "cout",
      "bins": [
        { "cout_0": "{0}" },
        { "cout_1": "{1}" }
      ]
    },
    {
      "name": "cp_sum",
      "signal": "sum",
      "bins": [
        { "sum_zero": "{0}" },
        { "sum_mid": "{[1: 254]}" },
        { "sum_max": "{255}" }
      ]
    },
    {
      "name": "cp_a_max_corner",
      "signal": "a",
      "bins": [ { "a_eq_255": "{255}" } ]
    },
    {
      "name": "cp_b_max_corner",
      "signal": "b",
      "bins": [ { "b_eq_255": "{255}" } ]
    },
    {
      "name": "cp_b_zero_corner",
      "signal": "b",
      "bins": [ { "b_eq_0": "{0}" } ]
    },
    {
      "name": "cp_cin_1_corner",
      "signal": "cin",
      "bins": [ { "cin_eq_1": "{1}" } ]
    },
    {
      "name": "cp_cout_1_corner",
      "signal": "cout",
      "bins": [ { "cout_eq_1": "{1}" } ]
    }
  ],
  "coverage_crosses": [
    {
      "name": "overflow_corner",
      "coverpoints": ["cp_a_max_corner", "cp_b_max_corner", "cp_cin_1_corner"]
    },
    {
      "name": "carry_in_carry_out",
      "coverpoints": ["cp_cin_1_corner", "cp_cout_1_corner"]
    },
    {
      "name": "wrap_corner",
      "coverpoints": ["cp_a_max_corner", "cp_b_zero_corner", "cp_cin_1_corner"]
    }
  ]
}
