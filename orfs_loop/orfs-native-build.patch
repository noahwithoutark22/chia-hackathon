diff --git a/flow/platforms/sky130hd/lvs/sky130hd.lylvs b/flow/platforms/sky130hd/lvs/sky130hd.lylvs
index 52256671d..27def7f35 100644
--- a/flow/platforms/sky130hd/lvs/sky130hd.lylvs
+++ b/flow/platforms/sky130hd/lvs/sky130hd.lylvs
@@ -25,7 +25,12 @@ if $in_gds
 end
 
 if $report_file
-  report($report_file)
+  # report() is DRC's report-database call, inherited by LVS but not the
+  # one that writes an LVS database -- with it, `make lvs` produced no
+  # 6_lvs.lvsdb at all, so a "Netlists don't match" could not be
+  # diagnosed from any artifact the flow kept. report_lvs() is the LVS
+  # equivalent. Host-local patch, like the sky130hd.cdl ones.
+  report_lvs($report_file)
 else
   report_lvs("lvs_report.lvsdb")
 end
@@ -218,11 +223,21 @@ netlist # ... not really required
 align
 # SIMPLIFICATION of the netlist
 #netlist.make_top_level_pins
-#netlist.combine_devices
+# Device combination, and simplification applied SYMMETRICALLY to both sides.
+# Upstream shipped `combine_devices` commented out and simplified only the
+# layout netlist, which is why sky130 std cells could never match: sky130 CDL
+# declares `m=2` on transistor stacks, so the layout extracts folded fingers
+# (e.g. a21oi_2: four 0.65um devices + two internal nodes) against a schematic
+# of doubled-width devices (two 1.3um + one node). This is netgen
+# sky130_setup.tcl's netgen's per-device `parallel enable` / `series enable`.
+# Simplifying only one side also left the schematic's device-less physical
+# cells (fill/tap/diode) unpurged and permanently unmatchable.
+netlist.combine_devices
 #netlist.purge
 #netlist.purge_nets
 netlist.simplify
-#schematic.simplify
+schematic.combine_devices
+schematic.simplify
 
 # Tolerances for the devices extracted parameters
 #  tolerance(device_class_name, parameter_name [, :absolute =&gt; absolute_tolerance] [, :relative =&gt; relative_tolerance])
