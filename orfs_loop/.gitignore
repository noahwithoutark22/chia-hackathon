# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Closure-loop run artifacts ---
# Everything orfs_loop.py / the GUI produces per run: summary.json,
# tool_trace.log, GDS files, layout previews, flow_logs/, driver.log, etc.
# (see CLAUDE.md "Run outputs" for the full layout). Regenerated by running
# the loop -- never hand-authored, never needs to be committed.
orfs_runs/*
!orfs_runs/bp-sky-gcd
!orfs_runs/bp-sky-gcd/**

# --- Onboarding staging output ---
# orfs_onboard.py's host-side staging copy of a design's generated
# config.mk/constraint.sdc/RTL. The copy that actually matters lives under
# orfs-native-build/flow/designs/... instead; this one is disposable.
generated-flow-configs/

# --- OS / editor cruft ---
.DS_Store

CLAUDE.md

# rtl_to_gds.py-generated ORFS designs
rtl_to_gds_designs/
